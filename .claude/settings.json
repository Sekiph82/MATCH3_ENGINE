{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-remote *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git fetch *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Bash(dotnet test *)",
      "PowerShell(dotnet test *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.p12)",
      "Read(./**/*.p8)",
      "Read(./**/*.keystore)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(eas build *)",
      "Bash(eas workflow:run *)",
      "Bash(firebase test *)",
      "Bash(gcloud firebase test *)",
      "PowerShell(git push --force *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh run rerun *)",
      "PowerShell(eas build *)",
      "PowerShell(firebase test *)"
    ]
  }
}
